<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DeckUtility.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DeckUtility.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Padding="10">
    <Design.DataContext>
        <vm:HomeViewModel />
    </Design.DataContext>
    <StackPanel Spacing="10">
        <Border BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="8"
                Height="100"
                Padding="5">
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="DarkGray"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="5">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Image Height="40" Source="../Assets/avalonia-logo.ico"/>
                        <TextBlock Text="GameScope"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Spacing="5" Margin="0,20,0,0">
            <TextBlock Text="{Binding StatusText}" 
                       HorizontalAlignment="Left" 
                       FontSize="16"/>
            <Button Content="Run Test Terminal Command" 
                    Command="{Binding RunTestCommand}"
                    HorizontalAlignment="Left"/>
        </StackPanel>
    </StackPanel>

</UserControl>
